# SafeCheck backend environment variables

DATABASE_URL=sqlite:///./safecheck.db

# OpenRouter
OPENROUTER_API_KEY=
# Locked to a free (0-cost) OpenRouter model that supports strict JSON
# structured output. As of Sep 2026, free Qwen/Llama tiers with JSON
# support have been delisted from OpenRouter; z-ai/glm-5.2:free is the
# best available free alternative (256k context, no expiration date).
# Fallback: google/gemma-4-31b-it:free
OPENROUTER_MODEL=z-ai/glm-5.2:free
# Optional, defaults to 5 seconds. Failures use deterministic explanations.
OPENROUTER_TIMEOUT_SECONDS=5

# Gmail OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:8000/v1/email/connect/callback
# Frontend page users land on after the Gmail consent flow completes
FRONTEND_URL=http://localhost:3000

# Optional URL intelligence providers
GOOGLE_SAFE_BROWSING_API_KEY=
VIRUSTOTAL_API_KEY=

# Optional WhatsApp Business adapter
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
META_APP_SECRET=
